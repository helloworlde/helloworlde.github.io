{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "hellowood-ai-search-context",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "blog.hellowood.dev/api/ai/*",
      "zone_name": "hellowood.dev"
    }
  ],
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "instance_name": "blog",
      "remote": true
    }
  ],
  "vars": {
    "BLOG_ORIGIN": "https://blog.hellowood.dev",
    "AI_SEARCH_PUBLIC_ENDPOINT": "https://ai.blog.hellowood.dev"
  },
  "observability": {
    "enabled": true
  }
}
